          return store.getItem(storageKey) || defaultTheme;\n        }\n\n        function getSystemTheme() {\n            return systemTheme;\n        }\n\n        function getDefaultTheme() {\n            return defaultTheme;\n        }\n\n        return { setTheme, getTheme, getSystemTheme, getDefaultTheme };\n    })();\n    theme.setTheme(theme.getTheme());\n</script></head><body><div id=\"sui-toaster\" class=\"top-center\"><div id=\"sui-toast-drawer\" data-offset=\"32\" data-gap=\"8\" data-duration=\"4000\" style=\"top: 32px;left: 50%; transform: translateX(-50%);--gap: 8px;padding-left: 32px;padding-right: 32px;\"></div></div><script type=\"module\" src=\"/mock/path/FirstTimeSetupLayout.astro?astro&type=script&index=0&lang.ts\"></script><main><div class=\"container\"></div></main></body></html>","hidden":false,"excluded":false,"masked":false}],"start":1790997099204,"stop":1790997099223,"duration":19,"type":"step","hasSimilarErrorInSubSteps":false}],"error":{},"testCase":{"id":"61ff1c404f3a74172beff757de3eaeb7","externalId":"571220265d2832d041e557d0250f38c5","name":"Layout Container tests - FirstTimeSetupLayout component","fullName":"root:packages/studiocms/test/layouts.test.ts#studiocms Tests Layout Container tests - FirstTimeSetupLayout component"},"retryHash":"7d03c7dfbf60548e7657769e27a4c9c0","environment":"default","setup":[],"teardown":[],"history":[{"id":"79819c93e796ea41dfa5fb56bff6841a","name":"Layout Container tests - FirstTimeSetupLayout component","fullName":"root:packages/studiocms/test/layouts.test.ts#studiocms Tests Layout Container tests - FirstTimeSetupLayout component","environment":"default","status":"passed","start":1790877420117,"stop":1790877420143,"duration":26,"labels":[{"name":"owner","value":"withstudiocms"},{"name":"lead","value":"Adam Matthiesen"},{"name":"framework","value":"Vitest"},{"name":"language","value":"TypeScript/JavaScript"},{"name":"framework","value":"vitest"},{"name":"language","value":"javascript"},{"name":"parentSuite